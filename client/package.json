{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apollo/client": "^3.4.10",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.3",
    "@mui/x-data-grid": "^6.0.0",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "@types/cors": "^2.8.12",
    "@types/jest": "^27.0.1",
    "@types/react": "^17.0.19",
    "@types/react-chartjs-2": "^2.5.7",
    "@types/react-dom": "^17.0.9",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-tag-autocomplete": "^6.1.1",
    "chart.js": "^3.7.1",
    "cors": "^2.8.5",
    "graphiql": "^2.4.0",
    "graphql": "^15.5.1",
    "graphql-request": "^3.7.0",
    "graphql-tag": "^2.12.6",
    "js-yaml": "^4.1.0",
    "lint-staged": "^15.2.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^4.1.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-hook-form": "^7.14.1",
    "react-query": "^3.34.0",
    "react-router-dom": "^6.2.2",
    "react-sticky": "^6.0.3",
    "react-tag-autocomplete": "^6.3.0",
    "sass": "^1.38.1",
    "web-vitals": "^1.0.1"
  },
  "scripts": {
    "start": "vite --mode local",
    "build": "yarn lint && vite build --mode production",
    "test": "jest",
    "lint": "eslint --fix --ext .js,.ts,.tsx ./src --ignore-path .gitignore --config .eslintrc.js",
    "lint:warn": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-path .gitignore",
    "prettier": "prettier --ignore-path .gitignore --write \"**/*.+(js|json|ts|tsx)\"",
    "prettier-check": "prettier -c --ignore-path .gitignore \"**/*.+(js|json|ts|tsx)\"",
    "format": "yarn run prettier -- --write",
    "start:prod": "vite --mode production",
    "start:staging": "vite --mode staging",
    "build:prod": "yarn lint && vite build --mode production",
    "build:staging": "yarn lint && vite build --mode staging",
    "build:dev": "yarn lint && vite build --mode dev"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@ef-carbon/tspm": "^2.2.5",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-babel-module": "^5.3.1",
    "eslint-import-resolver-typescript": "^2.4.0",
    "eslint-plugin-cypress": "^2.11.3",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-jest-dom": "^3.9.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-testing-library": "^4.6.0",
    "husky": "^6.0.0",
    "prettier": "^2.3.0",
    "tsconfig-paths": "^3.14.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-svgr": "^4.3.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.+)": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{js,jsx,ts,tsx}",
      "!src/test/**/*.{js,jsx,ts,tsx}"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "yarn lint",
      "yarn prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": true
  }
}
